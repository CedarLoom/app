{
  "name": "cedarloom-app",
  "private": true,
  "type": "module",
  "license": "ISC",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "pnpm --recursive --filter !@cedarloom/app run build && pnpm --filter @cedarloom/app run build",
    "typecheck": "pnpm --recursive --parallel run typecheck && tsc --project tsconfig.json",
    "lint": "oxlint",
    "format": "biome check --write .",
    "format:check": "biome ci .",
    "test": "vitest run",
    "knip": "knip --max-issues 0",
    "jscpd": "jscpd .",
    "licenses": "pnpm licenses list --recursive --json | node scripts/licenses.ts",
    "check": "sh scripts/check.sh",
    "check:changed": "git diff -z --name-only --diff-filter=d --merge-base origin/main | lefthook run pre-commit --files-from-stdin && git diff -z --name-only --diff-filter=d --merge-base origin/main | lefthook run pre-push --files-from-stdin"
  },
  "knip": {
    "ignoreBinaries": [
      "icacls",
      "mkfifo",
      "schemathesis"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/node": "catalog:",
    "jscpd": "catalog:",
    "knip": "catalog:",
    "lefthook": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  }
}
