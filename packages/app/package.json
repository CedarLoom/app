{
  "name": "@cedarloom/app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=26"
  },
  "bin": {
    "cedarloom-app": "bin/cedarloom-app.js"
  },
  "exports": "./src/index.ts",
  "files": [
    "bin",
    "src",
    "!src/**/*.test.ts",
    "dist/ui"
  ],
  "scripts": {
    "build": "node scripts/copy-ui.ts",
    "messages": "node ../core/scripts/compile-messages.ts && biome format --write src/messages",
    "typecheck": "tsc",
    "openapi": "node scripts/openapi.ts && biome format --write openapi.json"
  },
  "dependencies": {
    "@cedarloom/core": "workspace:*",
    "@cedarloom/use-cases": "workspace:*",
    "@fastify/helmet": "catalog:",
    "@fastify/swagger": "catalog:",
    "fastify": "catalog:",
    "fastify-type-provider-zod": "catalog:",
    "openapi-types": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
