{
  "name": "@cedarloom/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "ISC",
  "engines": {
    "node": ">=26"
  },
  "exports": {
    ".": "./src/index.ts",
    "./messages/en.json": "./src/messages/en.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./messages/en.json": "./src/messages/en.json"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.js",
    "src/messages/en.json"
  ],
  "scripts": {
    "typecheck": "tsc && tsc --project tsconfig.node.json",
    "build": "node --eval \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc --noEmit false --rootDir src --outDir dist",
    "prepack": "pnpm run build",
    "messages": "node scripts/compile-messages.ts && biome format --write src/messages"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@lingui/format-po": "catalog:",
    "@lingui/message-utils": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
