msgid ""
msgstr ""
"Content-Type: text/plain; charset=utf-8\n"
"Language: en\n"

#. js-lingui-explicit-id
msgid "store.version-unsupported"
msgstr "The CedarLoom state store has version {found}, and this version of CedarLoom reads only version {supported}."

#. js-lingui-explicit-id
msgid "store.locked"
msgstr "The CedarLoom state store {path} is in use by another CedarLoom process, for example a running cedarloom-app. Stop it, or make the change from the UI."

#. js-lingui-explicit-id
msgid "store.unreadable"
msgstr "The CedarLoom state store {path} cannot be read or written. Nothing was changed."

#. js-lingui-explicit-id
msgid "plan.file-changed"
msgstr "{path} changed after the plan was made. Nothing was overwritten. Review the file and make the plan again."

#. js-lingui-explicit-id
msgid "plan.stale"
msgstr "The plan changed since it was shown. Review the new plan before you apply it."

#. js-lingui-explicit-id
msgid "plan.path-outside-roots"
msgstr "{path} is outside the folders CedarLoom writes to (.claude/ and .cedarloom/workflows/)."

#. js-lingui-explicit-id
msgid "plan.symlink"
msgstr "{path} is a symbolic link. CedarLoom does not write through links."

#. js-lingui-explicit-id
msgid "plan.not-text"
msgstr "{path} is not a UTF-8 text file. CedarLoom writes only text files."

#. js-lingui-explicit-id
msgid "plan.text-mismatch"
msgstr "The new text of {path} does not match the plan's hash. Nothing was changed. Make the plan again."

#. js-lingui-explicit-id
msgid "plan.name-too-long"
msgstr "The name of {path} leaves no room for the temporary names CedarLoom writes beside it. Nothing was changed. Use a shorter name."

#. js-lingui-explicit-id
msgid "apply.backup-failed"
msgstr "The backup of {path} failed, so run {run} stopped and the file was not changed."

#. js-lingui-explicit-id
msgid "apply.write-mismatch"
msgstr "{path} does not match the plan after the write. Run {run} stopped; run cedarloom runs show {run} to see which steps were written."

#. js-lingui-explicit-id
msgid "apply.recovered"
msgstr "{path} was left from the interrupted run {run} and was settled."

#. js-lingui-explicit-id
msgid "run.not-found"
msgstr "No run with the id {run}."

#. js-lingui-explicit-id
msgid "run.already-undone"
msgstr "Run {run} was already undone by run {by}."

#. js-lingui-explicit-id
msgid "undo.replaced"
msgstr "Run {run} was undone again later by run {by}, so an older undo of it can no longer be brought back."

#. js-lingui-explicit-id
msgid "undo.file-changed"
msgstr "{path} changed after the run, so undo would lose that change. Nothing was restored."

#. js-lingui-explicit-id
msgid "undo.result-kept"
msgstr "{path} is still as run {run} left it, and this undo would leave run {run} counted as undone. Nothing was restored."

#. js-lingui-explicit-id
msgid "undo.backup-missing"
msgstr "The backup of {path} is missing, so the run cannot be undone."

#. js-lingui-explicit-id
msgid "undo.backup-changed"
msgstr "The backup of {path} no longer matches its recorded hash, so the run cannot be undone."

#. js-lingui-explicit-id
msgid "node.version-unsupported"
msgstr "Node.js {found} is running; CedarLoom needs Node.js {required}."

#. js-lingui-explicit-id
msgid "project.not-found"
msgstr "{cwd} is not inside a Git repository. Run CedarLoom from your project folder."

#. js-lingui-explicit-id
msgid "plugin.found"
msgstr "Found {id} {version, select, null {with no recorded version} other {version {version}}} ({scope} scope) at {root}."

#. js-lingui-explicit-id
msgid "plugin.not-found"
msgstr "The cl-workflow plugin from the CedarLoom marketplace is not installed for this project in {pluginsRoot}. Install it with claude plugin marketplace add CedarLoom/cedarloom and then claude plugin install cl-workflow@cedarloom, or name a plugin folder with --plugin-root."

#. js-lingui-explicit-id
msgid "plugin.record-unknown"
msgstr "{file} cannot be read or has a shape CedarLoom does not know, so the plugin cannot be located. Name the plugin folder with --plugin-root."

#. js-lingui-explicit-id
msgid "plugin.untrusted"
msgstr "{id} is not cl-workflow from the CedarLoom marketplace, so CedarLoom will not run its generator."

#. js-lingui-explicit-id
msgid "plugin.marketplace-untrusted"
msgstr "The marketplace {marketplace} comes from {source}, not from the CedarLoom/cedarloom repository, so CedarLoom will not run its plugins. Name a plugin folder you trust with --plugin-root."

#. js-lingui-explicit-id
msgid "plugin.too-old"
msgstr "The cl-workflow plugin at {root} ({version, select, null {no recorded version} other {version {version}}}) has no workflow generator. Update the plugin."

#. js-lingui-explicit-id
msgid "plugin.trust-bypassed"
msgstr "Using the plugin folder {root} from --plugin-root. Its origin was not checked."

#. js-lingui-explicit-id
msgid "plugin.disabled"
msgstr "{path, select, null {No settings file enables cl-workflow@cedarloom} other {cl-workflow@cedarloom is switched off in {path}}}, so the workflows generated for this project will not run."

#. js-lingui-explicit-id
msgid "settings.unreadable"
msgstr "{path} cannot be read, is not a JSON object, or its enabledPlugins is not an object, so CedarLoom will not use or change it. Fix the file first."

#. js-lingui-explicit-id
msgid "definition.invalid"
msgstr "The workflow definition {name} has {count, plural, one {# problem} other {# problems}}. Run cedarloom workflows validate {name} for details."

#. js-lingui-explicit-id
msgid "definition.stale"
msgstr "The files generated from {name} differ from what the plugin generates now: {paths}. Run cedarloom workflows generate {name}."

#. js-lingui-explicit-id
msgid "definition.not-json"
msgstr "{path} cannot be read, or is not valid JSON."

#. js-lingui-explicit-id
msgid "generator.failed"
msgstr "The workflow generator stopped with {signal, select, null {exit code {exitCode}} other {signal {signal}}}: {stderr}"

#. js-lingui-explicit-id
msgid "generator.output-unknown"
msgstr "The workflow generator printed output CedarLoom cannot read: {output}"

#. js-lingui-explicit-id
msgid "session.host"
msgstr "This server answers only at 127.0.0.1."

#. js-lingui-explicit-id
msgid "session.origin"
msgstr "Requests from other sites are refused."

#. js-lingui-explicit-id
msgid "session.token"
msgstr "This link was already used or has expired. Run cedarloom-app again for a new one."

#. js-lingui-explicit-id
msgid "session.cookie"
msgstr "No valid session. Open the link that cedarloom-app printed."

#. js-lingui-explicit-id
msgid "session.csrf"
msgstr "The request is missing its session check. Reload the page."

#. js-lingui-explicit-id
msgid "server.port-in-use"
msgstr "Port {port} is in use. Choose another with --port, or leave it out to use a free port."

#. js-lingui-explicit-id
msgid "server.open-hint"
msgstr "If the browser shows an error about a file instead of CedarLoom, open the URL printed above."

#. js-lingui-explicit-id
msgid "api.bad-request"
msgstr "The request is not valid. Fields with issues: {issues}"

#. js-lingui-explicit-id
msgid "api.not-found"
msgstr "Not found."

#. js-lingui-explicit-id
msgid "api.internal"
msgstr "Something went wrong in CedarLoom. The details are in the terminal where cedarloom-app runs."

#. js-lingui-explicit-id
msgid "cli.unknown-command"
msgstr "Unknown command: {command}. Run {bin} --help for usage."

#. js-lingui-explicit-id
msgid "cli.unknown-flag"
msgstr "{command} has no option {flag}."

#. js-lingui-explicit-id
msgid "cli.missing-argument"
msgstr "{command} needs {argument}."

#. js-lingui-explicit-id
msgid "cli.bad-value"
msgstr "{value} is not a valid value for {flag}."

#. js-lingui-explicit-id
msgid "cli.flag-conflict"
msgstr "These options cannot be used together: {flags}."

#. js-lingui-explicit-id
msgid "cli.confirm-required"
msgstr "This plan was not applied. Run the command again with --yes to apply it."

#. js-lingui-explicit-id
msgid "cli.internal"
msgstr "CedarLoom stopped on an unexpected error. Please report it with the output above."
