{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "node"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "options": {
    "typeAware": true,
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "error"
  },
  "rules": {
    "complexity": [
      "error",
      {
        "max": 10
      }
    ],
    "max-depth": [
      "error",
      {
        "max": 3
      }
    ],
    "max-lines-per-function": [
      "error",
      {
        "max": 50,
        "skipBlankLines": true,
        "skipComments": true
      }
    ],
    "max-params": [
      "error",
      {
        "max": 4
      }
    ],
    "no-nested-ternary": "error",
    "no-else-return": "error",
    "no-lonely-if": "error",
    "no-unneeded-ternary": "error",
    "no-useless-return": "error",
    "no-useless-catch": "error",
    "prefer-const": "error",
    "import/no-cycle": "error",
    "unicorn/prefer-node-protocol": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/no-unnecessary-boolean-literal-compare": "error",
    "typescript/no-unnecessary-type-parameters": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-explicit-any": "error",
    "typescript/ban-ts-comment": "error",
    "typescript/no-floating-promises": "error",
    "typescript/triple-slash-reference": [
      "error",
      {
        "types": "never",
        "lib": "never",
        "path": "never"
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "packages/use-cases/src/index.ts",
        "packages/app/src/index.ts",
        "packages/ui/src/index.ts",
        "packages/cli/src/index.ts"
      ],
      "rules": {
        "unicorn/no-empty-file": "off"
      }
    },
    {
      "files": ["packages/core/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["node:*", "node:*/**"],
                "message": "core is pure logic and uses no Node APIs."
              },
              {
                "group": [
                  "@cedarloom/use-cases",
                  "@cedarloom/app",
                  "@cedarloom/ui",
                  "@cedarloom/cli",
                  "**/use-cases/**",
                  "**/app/**",
                  "**/ui/**",
                  "**/cli/**"
                ],
                "message": "core is the bottom layer and imports no other workspace package."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/core/src/**/*.test.ts", "packages/core/scripts/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@cedarloom/use-cases",
                  "@cedarloom/app",
                  "@cedarloom/ui",
                  "@cedarloom/cli",
                  "**/use-cases/**",
                  "**/app/**",
                  "**/ui/**",
                  "**/cli/**"
                ],
                "message": "core's tests and scripts run on Node and import no other workspace package."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/use-cases/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@cedarloom/app", "@cedarloom/ui", "@cedarloom/cli", "**/app/**", "**/ui/**", "**/cli/**"],
                "message": "use-cases imports core only."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/app/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@cedarloom/ui", "@cedarloom/cli", "**/ui/**", "**/cli/**"],
                "message": "app imports core and use-cases only."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/ui/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["node:*", "node:*/**"],
                "message": "The UI runs in the browser and uses no Node APIs."
              },
              {
                "group": [
                  "@cedarloom/use-cases",
                  "@cedarloom/app",
                  "@cedarloom/cli",
                  "**/use-cases/**",
                  "**/app/**",
                  "**/cli/**"
                ],
                "message": "The UI imports core only and reaches the app's server over HTTP."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/cli/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@cedarloom/app", "@cedarloom/ui", "**/app/**", "**/ui/**"],
                "message": "The CLI imports core and use-cases only."
              }
            ]
          }
        ]
      }
    }
  ]
}
